+    cv.put(rr, x + 1, "○", f"{HEX['bright'] if is_sel else 'mut'}{bg}")
+    cv.put(rr, x + 2, " " + title, f"{bold}{fg}{bg}")
+    cv.put(rr, x + 3 + vis(title), " " * gap, f"{bold}{fg}{bg}")
+    cv.put(rr, x + 3 + vis(title) + gap, meta, f"{HEX['bright'] if is_sel else HEX[meta_k]}{bg}")
+    cv.put(rr, x + 3 + vis(title) + gap + vis(meta), " ", f"{bold}{fg}{bg}")
+    return is_sel
