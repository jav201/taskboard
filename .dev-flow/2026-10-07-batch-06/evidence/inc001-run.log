import sys; sys.path.insert(0, 'tests')
from datetime import date
from taskboard.models import Board, Project, Task
from taskboard.views import render_kanban, _phase_window

def kanban_board():
    b = Board.load('k.json')
    b.projects.clear(); b.tasks.clear()
    alpha = Project('Alpha', 'cyan', 'on_track')
    beta = Project('Beta', 'amber', 'on_track')
    b.projects += [alpha, beta]
    b.tasks += [Task('KA one', alpha.id, 'Backlog'), Task('KA two', alpha.id, 'Backlog'),
                Task('KA three', alpha.id, 'Backlog'), Task('KA doing', alpha.id, 'Doing'),
                Task('KB done', beta.id, 'Done'), Task('KB blocked', beta.id, 'Doing', blocked=True),
                Task('Loose one', None, 'Backlog')]
