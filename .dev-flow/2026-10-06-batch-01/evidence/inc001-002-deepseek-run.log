import sys, asyncio, tempfile, pathlib
sys.path.insert(0, "tests")
from datetime import date, timedelta
import kg_board
from taskboard.app import TaskboardApp
from textual.widgets import Button, Input

def toast_text(app):
    return "\n".join(str(t.render()) for t in app.screen.query("Toast"))

async def main():
    d = pathlib.Path(tempfile.mkdtemp()); path = d/"board.json"
    b = kg_board.milestones(kg_board.shifted(path), date.today())
    b.settings["seen_view_renumber_2026_07"]=True; b.save()
    app = TaskboardApp(board_path=str(path), team_sync_interval=1e9)
    async with app.run_test(size=(118,30), notifications=True) as pilot:
        await pilot.press("4"); await pilot.pause()
        app.selected_task_id="tm2"; app.refresh_view()
        d0 = app.board.task_by_id("tm2").due_date
        await pilot.press("+"); await pilot.pause()
        print("after + :", app.board.task_by_id("tm2").due_date, "stack", len(app._undo_stack))
        await pilot.press("u"); await pilot.pause()
        print("after u :", app.board.task_by_id("tm2").due_date, "stack", len(app._undo_stack))
        app.clear_notifications()
        await pilot.press("m"); await pilot.pause()
        print("after m (post-u):", app.board.task_by_id("tm2").due_date,
              "| toast:", toast_text(app).replace("\n"," / "))
        # scenario B: + then title-only editor save then m
        app.clear_notifications()
        await pilot.press("+"); await pilot.pause()
        await pilot.press("e")
        for _ in range(3): await pilot.pause()
        app.screen.query_one("#f-title", Input).value = "Renamed tm2"
        await pilot.pause()
        app.screen.query_one("#save", Button).press()
        for _ in range(3): await pilot.pause()
        print("after editor title save: stack", len(app._undo_stack),
              "due", app.board.task_by_id("tm2").due_date)
        before_m = app.board.task_by_id("tm3").due_date
        app.clear_notifications()
        await pilot.press("m"); await pilot.pause()
        print("after m following title-edit: tm3", before_m, "->", app.board.task_by_id("tm3").due_date,
              "| toast:", toast_text(app).replace("\n"," / "))
asyncio.run(main())
