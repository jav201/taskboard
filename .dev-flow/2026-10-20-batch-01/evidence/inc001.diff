+        app._gantt_group, app._gantt_previous = "g1", "g0"
+        app._last_history_error = "x"
+
+        class _Timer:
+            stopped = False
+
+            def stop(self):
+                self.stopped = True
+        timer = _Timer()
+        app._team_timer = timer
+        calls = []
+        real_open = app._open_board
+        app._open_board = lambda **k: (calls.append(k), real_open(**k))[1]
+        same = app.board
