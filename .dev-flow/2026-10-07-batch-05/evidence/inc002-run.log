import asyncio
from pathlib import Path
from tempfile import TemporaryDirectory
from taskboard.app import TaskboardApp
from taskboard.models import Board, Project, Task

async def main():
    with TemporaryDirectory() as d:
        d = Path(d)
        p = Project("Platform", "sky")
        t = Task("Widget", p.id, "Doing")
        b = Board([p], [t], d / "board.json", {"seen_view_renumber_2026_07": True}, ["Backlog","Doing","Done"])
        b.save()
        app = TaskboardApp(board_path=str(b.path), team_sync_interval=1e9)
        async with app.run_test(size=(80, 24)) as pilot:
            await pilot.pause()
            await pilot.press("4")
            await pilot.pause()
            await pilot.press("question_mark")
            await pilot.pause()
            from textual.widgets import Label, VerticalScroll
            for w in app.screen.query(Label):
                if "project band" in str(w.render()):
                    print("region:", w.region, "content_size:", w.content_size)
                    print("styles width:", w.styles.width, "text-wrap:", w.styles.text_wrap, "text-overflow:", w.styles.text_overflow)
                    print("content_width:", w.content_width)
            for vs in app.screen.query(VerticalScroll):
                print("VS id:", vs.id, "region:", vs.region)

asyncio.run(main())
