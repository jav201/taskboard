import asyncio
from pathlib import Path
from tempfile import TemporaryDirectory
from taskboard.app import TaskboardApp
from taskboard.models import Board, Project, Task

async def main():
    with TemporaryDirectory() as d:
        d = Path(d)
        p = Project("Platform", "sky")
        t = Task("Widget", p.id, "Doing")
        b = Board([p], [t], d / "board.json", {"seen_view_renumber_2026_07": True}, ["Backlog","Doing","Done"])
        b.save()
        app = TaskboardApp(board_path=str(b.path), team_sync_interval=1e9)
        async with app.run_test(size=(80, 24)) as pilot:
            await pilot.pause()
            await pilot.press("4")  # kanban
            await pilot.pause()
            await pilot.press("question_mark")
            await pilot.pause()
            from textual.widgets import Label
            print("=== screen:", type(app.screen).__name__)
            for w in app.screen.query(Label):
                print(repr(str(w.render())))
            # also painted rows off the help box
            strips = app.screen._compositor.render_strips(app.screen.size)
            box = app.screen.query_one("#help-modal-box")
            r = box.content_region
            print("=== painted help box region", r)
            for s in strips[r.y:r.y+r.height]:
                print(repr(s.crop(r.x, r.x+r.width).text))

asyncio.run(main())
