import asyncio, tempfile, pathlib
import kg_board
from taskboard.app import TaskboardApp
from taskboard.views import nav_model
from taskboard import keymap

async def main():
    d = pathlib.Path(tempfile.mkdtemp())
    path = d/'board.json'
    b = kg_board.shifted(path); b.settings['seen_view_renumber_2026_07']=True; b.save()
    app = TaskboardApp(board_path=str(path), team_sync_interval=1e9)
    async with app.run_test(size=(118,30), notifications=True) as pilot:
        print('default view', app.view_mode, 'default sel', app.selected_task_id)
        await pilot.press('3'); await pilot.pause()
        print('after 3 view', app.view_mode, 'sel', app.selected_task_id)
        print('keymap VIEWS', keymap.VIEWS)
        cols = app._nav_columns()
        print('kanban cols:', cols)
