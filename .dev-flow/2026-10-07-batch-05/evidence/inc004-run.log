        for _ in range(80):
            if app.selected_task_id=='ta4': break
            await pilot.press('down'); await pilot.pause()
        print('reached ta4?', app.selected_task_id)
        for _ in range(80):
            if app.selected_task_id=='ta5': break
            await pilot.press('down'); await pilot.pause()
