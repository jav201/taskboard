import sys; sys.path.insert(0, 'tests')
import asyncio
from taskboard.app import TaskboardApp
from textual.widgets import Static
import tempfile, os

async def main():
    d = tempfile.mkdtemp()
    app = TaskboardApp(board_path=os.path.join(d, 'board.json'))
    orig = app.refresh_view
    calls = {'n': 0}
    def wrap():
        calls['n'] += 1
        bw = app.query('#board').first() if app.query('#board') else None
        w = bw.size.width if bw else None
        vps = app.query('#viewport')
        h = vps.first().size.height if vps else None
        orig()
        print(f'refresh #{calls[\"n\"]}: w={w} h={h} sel={app.selected_task_id} lm={len(app._line_map)}')
    app.refresh_view = wrap
    async with app.run_test(size=(80,24)) as pilot:
        await pilot.pause()
        print('final sel', app.selected_task_id, 'lm', len(app._line_map))

asyncio.run(main())
