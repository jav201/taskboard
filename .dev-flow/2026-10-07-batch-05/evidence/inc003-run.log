import sys; sys.path.insert(0, 'tests')
import asyncio, tempfile, os
from datetime import date
import kg_board
from kg_board import TODAY
from taskboard.app import TaskboardApp
from taskboard import views, models

class _Today(date):
    @classmethod
    def today(cls): return TODAY

async def main():
    # patch date like the frozen fixture
    import taskboard.app as app_mod
    views.date = _Today; models.date = _Today; app_mod.date = _Today; kg_board.date = _Today
    d = tempfile.mkdtemp()
    b = kg_board.build(os.path.join(d,'board.json'))
    b.save()
    app = TaskboardApp(board_path=str(b.path), team_sync_interval=1e9)
    async with app.run_test(size=(118,34)) as pilot:
        await pilot.pause()
        app.selected_task_id = 'tw1'
        await pilot.press('3')
        await pilot.pause()
