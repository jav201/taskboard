import sys; sys.path.insert(0, 'tests')
from datetime import date, timedelta
import kg_board
from kg_board import TODAY
from taskboard import views
from taskboard.models import Task

def make(nchains):
    b = kg_board.build('probe.json')
    today = kg_board.TODAY
    for k in range(nchains):
        for pid in ('papi','pdwh'):
            a = Task(f'Head {pid} {k}', phase='Next', project_id=pid,
                     start_date=(today+timedelta(days=k)).isoformat(),
                     due_date=(today+timedelta(days=k+1)).isoformat(), id=f'h{pid}{k}')
            z = Task(f'Tail {pid} {k}', phase='Next', project_id=pid,
                     start_date=(today+timedelta(days=k+2)).isoformat(),
                     due_date=(today+timedelta(days=k+3)).isoformat(),
                     depends_on=[f'h{pid}{k}'], id=f't{pid}{k}')
            b.tasks += [a, z]
    return b

for nc in (0,1,2,3,4):
    b = make(nc)
    tasks, linked, depth, chain, ncol, bands, bare = views._chainmap_plan(b, False)
    # compute plans exactly like render_chainmap
    w = 80
    wide = w>=100
    gap = 5 if wide else 3
    tile_w = (w-2-gap*(ncol-1))//ncol
    plans = []
    for pr, ts in bands:
        slot={}; used={}
        for d in range(ncol):
            for t in (t for t in ts if depth[t.id]==d):
                pre=[slot[x] for x in t.depends_on if x in slot]
                s=sorted(pre)[len(pre)//2] if pre else 0
                while s in used.setdefault(d,set()): s+=1
                used[d].add(s); slot[t.id]=s
        edges=[(b.task_by_id(x),t) for t in ts for x in t.depends_on if x in slot]
        skips=[e for e in edges if depth[e[1].id]-depth[e[0].id]>1]
        nslot=max(slot.values())+1 if slot else 1
        plans.append(dict(pr=pr,ts=ts,tiles_h=3*nslot-1+len(skips),nslot=nslot))
    foot=3
    body_h=24-1-foot-1
    core=sum(1+p['tiles_h'] for p in plans)+(1 if bare else 0)
    print(f'nc={nc} ncol={ncol} body_h={body_h} core={core}')
    for p in plans:
        print('   ', p['pr'].id, 'nslot', p['nslot'], 'tiles_h', p['tiles_h'])
