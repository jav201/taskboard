+def _main(monkeypatch, *argv):
+    from taskboard import __main__ as entry
+    built = []
+    monkeypatch.setattr(sys, "argv", ["taskboard", *argv])
+    monkeypatch.setattr(TaskboardApp, "run", lambda self, *a, **k: built.append(self))
+    entry.main()
+    return built
