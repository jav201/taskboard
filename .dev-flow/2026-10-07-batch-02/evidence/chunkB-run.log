"""PROTOTYPE M-bM-^@M-^T capture round 7 (T-C2, C-2b) next to the originals (T-C, C-2).
    PYTHONIOENCODING=utf-8 python prototypes/kg_mejoras/capture_polish.py

Checks:
  size     exactly H rows x W cells, every glyph one cell wide (cell_len).
  board    the board passed in is unchanged (deep snapshot incl. `extra`).
  law      every accent cell (fg OR bg) of T-C2 / C-2b lies inside a declared
           focus region, and every declared region holds accent (not vacuous).
  critical heavy M-bM-^TM-^A cells exist and none of them is accent.
  tints    every {name} token wears ONE bg per name everywhere; names differ;
           each bg/fg clears HLS s >= 0.15 and survives 256-colour quantisation
           as a distinct, non-grey colour.
  switch   C-2b: each band's rule row marks exactly that band's mode.
  bands    C-2b: each band rule's shaded hue clears s >= 0.15, also at 256 colours.
"""
import colorsys
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from fixture import build, TODAY  # noqa: E402
from baseline import svg  # noqa: E402
from capture_round5 import snap  # noqa: E402
from rich.cells import cell_len  # noqa: E402
from rich.color import Color, ColorSystem  # noqa: E402
import variants_flow as VF  # noqa: E402
import variants_cascade as VC  # noqa: E402
import variants_polish as VP  # noqa: E402

SIZES = ((118, 30), (80, 24))
PAIRS = [("T-C", VF.render_tc, "T-C2", VP.render_tc2, "tm3"),
         ("C-2", VC.render_c2, "C-2b", VP.render_c2b, "tm3")]


def hls_s(hexv):
    r, g, b = (int(hexv[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return colorsys.rgb_to_hls(r, g, b)[2]


def check_size(key, text, W, H):
    plain = text.plain.split("\n")
    assert len(plain) == H, (key, W, H, len(plain))
    for i, ln in enumerate(plain):
        assert cell_len(ln) == W, (key, W, H, i, cell_len(ln), ln)
        assert len(ln) == W, (key, "a glyph is not 1 cell", i, ln)
    return plain


def check_law(key, text):
    acc = VP.accent_cells(text)
    regions = VP.STATS["focus"]
    per = {}
    for r, x, ch in acc:
        hit = next((ro for ro, rr, a, z in regions if rr == r and a <= x < z), None)
        assert hit in VP.FOCUS_ROLES, (key, "accent outside focus", r, x, ch)
        per[hit] = per.get(hit, 0) + 1
    for ro, rr, a, z in regions:
        assert any(r == rr and a <= x < z for r, x, _ in acc), (key, "empty focus region", ro, rr, a, z)
    heavy = [(r, i, s) for r, i, ch, s in VP.styled_cells(text) if ch in "M-bM-^TM-^AM-bM-^TM-^CM-bM-^TM-3M-bM-^TM-;M-bM-^TM-#M-bM-^TM-+M-bM-^UM-^KM-bM-^TM-^OM-bM-^TM-^SM-bM-^TM-^WM-bM-^TM-^["]
    assert heavy, (key, "no structural critical mark")
    inside = lambda r, i: any(rr == r and a <= i < z for _, rr, a, z in regions)  # noqa: E731
    assert not any(VP.ACCENT in (VP._hex(s.color), VP._hex(s.bgcolor))
                   for r, i, s in heavy if not inside(r, i)), (key, "critical wears accent")
    return per


def check_tints(key, text):
    seen = {}
    plain_rows = text.plain.split("\n")
    cells = {(r, i): s for r, i, _, s in VP.styled_cells(text)}
    for r, row in enumerate(plain_rows):
        for m in VP._TOK.finditer(row):
            nm = m.group(1)
            full = next((v for v in VP.VAR_TINT if v == nm or (m.group(2) == "M-bM-^@M-&" and nm and v.startswith(nm))), None)
            if full is None:
                bg0 = VP._hex(cells[(r, m.start())].bgcolor)
                assert bg0 in {bg for _, bg in VP.VAR_TINT.values()}, (key, "untinted cut token", r, row)
                continue
            bgs = {VP._hex(cells[(r, i)].bgcolor) for i in range(m.start(), m.end())}
