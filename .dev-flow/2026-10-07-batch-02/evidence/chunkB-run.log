import asyncio, sys, os
from pathlib import Path
from datetime import date, timedelta
sys.path.insert(0, str(Path.cwd() / "tests"))
import kg_board
import taskboard.app as app_mod
app_mod.milestones_marked = lambda settings: True
from taskboard.app import TaskboardApp
from taskboard.models import Task

def build_crowd(path, n=9):
    b = kg_board.shifted(path)
    # add n high tasks into Backlog of pweb
    for i in range(n):
        b.tasks.append(Task(f"Crowd high {i}", project_id="pweb", phase="Backlog",
                            priority="high", id=f"ch{i}"))
    b.save()
    return b

async def main():
    import tempfile
    for (w,h) in [(118,30),(80,24)]:
        d = Path(tempfile.mkdtemp())
        p = d / "board.json"
        b = build_crowd(p)
        app = TaskboardApp(board_path=str(p), team_sync_interval=1e9)
        async with app.run_test(size=(w,h)) as pilot:
            await pilot.press("4")
            await pilot.pause()
            bw = app.query_one("#board")
            print("TERM", w,h, "board size", bw.size.width, bw.size.height)
            rows = str(bw.render()).split("\n")
            for r in rows:
                if "more ↓" in r or "high" in r:
                    print(repr(r))
        print("---")

asyncio.run(main())
