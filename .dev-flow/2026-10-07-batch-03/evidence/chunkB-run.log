import sys
sys.path.insert(0, 'tests')
from datetime import date, timedelta
from pathlib import Path
import kg_board as kg
from taskboard.models import Board, Project, Task
from taskboard.views import render_kanban, legend_entries, kanban_plan
T = date.today()
def d(o): return (T+timedelta(days=o)).isoformat()
projs=[]; tasks=[]
for i in range(5):
    p=Project(f'Proj{i}', 'sky', id=f'p{i}'); projs.append(p)
    tasks.append(Task(f'work {i}', f'p{i}', 'Doing', due_date=d(5), id=f'w{i}'))
# the milestone rides the LAST project, drawn or folded
tasks.append(Task('the milestone', 'p4', 'Doing', start_date=d(6), due_date=d(6), milestone=True, id='m4'))
b=Board(projs, tasks, Path('x.json'), {}, ['Backlog','Doing','Done'])
for h in (30,20,15,12,10):
    txt=render_kanban(b, False, None, T, 118, h)
    rows=txt.plain.split(chr(10))
    band_d=[r for r in rows if r[:1]=='▐' and '◆' in r]
    ent=[m for _s,m in legend_entries('kanban', b, T, 118, h)]
    print('h=',h,'diamond-band-rows=',len(band_d),'legend=', 'a milestone on its project'+chr(39)+'s band rule' in ent, '| bands drawn:', [r.strip()[:20] for r in rows if r[:1]=='▐'])
    if not band_d and 'a milestone on its project'+chr(39)+'s band rule' in ent:
        print('   *** RED scenario: frame has NO band diamond but legend names it')
        break
