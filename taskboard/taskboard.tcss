/* taskboard - single dark theme, terminal-widget aesthetic */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

#viewport {
    width: 1fr;
    height: 1fr;
    padding: 0;
    scrollbar-size: 1 1;
    scrollbar-color: #334154;
    scrollbar-background: #0d1117;
}

/* the board fills the viewport width; height grows with content (scrolls) */
#board {
    width: 1fr;
    height: auto;
}

/* status bar docked at the bottom: two stacked rows (ribbon over footer).
   A single bottom-docked container guarantees they occupy DIFFERENT rows —
   two separate dock:bottom widgets collide on the same row. And with no
   border on the height:1 Ribbon it keeps a real content row (M22 §C-32). */
#statusbar {
    dock: bottom;
    height: 2;
    width: 1fr;
    background: #0b0f17;
}
Ribbon {
    height: 1;
    width: 1fr;
    background: #0b0f17;
    color: #8b98a5;
    padding: 0 1;
}
/* The key bar is generated from taskboard/keymap.py — the same table that
   generates BINDINGS, so what it shows and what works cannot drift. */
KeyBar {
    height: 1;
    width: 1fr;
    background: #0b0f17;
    color: #8b98a5;
    padding: 0 1;
}

/* ---- modals ---- */
.modal {
    width: 62;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #0d1219;
    border: round #334154;
}
#modal-box, #confirm-box {
    align: center middle;
}
/* titles are bold bright: the accent is kept for the field being edited
   (the colour budget, batch 2026-10-02-batch-02, HLR-202) */
.modal-title {
    color: #e6edf7;
    text-style: bold;
    margin-bottom: 1;
}
.modal Label {
    color: #8b98a5;
    margin-top: 1;
}
.modal-grid {
    grid-size: 2;
    grid-columns: 20 1fr;
    grid-gutter: 0 1;
    height: auto;
}
.modal-grid Label {
    margin-top: 1;
    content-align: left middle;
    height: 3;
}
.modal Input {
    border: tall #1b2431;
    background: #0b111a;
}
.modal Input:focus {
    border: tall #2dd4bf;
}
.modal Select {
    width: 1fr;
}
.modal-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}
.modal-buttons Button {
    margin-left: 1;
}

/* date field + calendar button (sits in the modal-grid's 1fr cell) */
.date-row {
    height: 3;
    width: 1fr;
}
.date-row .date-input {
    width: 1fr;
}
.cal-btn {
    width: 6;
    min-width: 6;
    height: 3;
    margin-left: 1;
}

/* ---- the task editor: full screen, notes | preview (verdict 2026-09-30) ----
   Every rule is scoped to #task-box so the project editor, which shares
   .modal / #modal-box, keeps its 62-column box. Controls are ONE row tall;
   they give up the tall border, so focus is marked by an accent bar on the
   left edge instead (the bar is always there, in the box's own background
   colour, so focusing never shifts the row by a cell). */
#task-box {
    width: 100%;
    height: 100%;
    padding: 0 1;
    background: #0d1219;
    border-top: solid #334154;
}
#task-head {
    height: 1;
}
#task-head .modal-title {
    width: auto;
    margin: 0 1 0 0;
}
#task-head #f-title {
    width: 1fr;
    text-style: bold;
}
#task-chips {
    height: 1;
    margin-top: 1;
}
#task-chips.-folded {
    layout: vertical;
    height: 2;
    margin-top: 0;
}
#task-chips-what, #task-chips-when {
    width: auto;
    height: 1;
}
#task-chips-when {
    margin-left: 1;
}
#task-chips.-folded #task-chips-when {
    margin-left: 0;
}
#task-box Input, #task-box Select, #task-box Checkbox, #task-box Button {
    height: 1;
    min-height: 1;
    border: none;
    border-left: tall #0d1219;
}
#task-box Input:focus, #task-box Select:focus, #task-box Checkbox:focus,
#task-box Button:focus {
    border-left: tall #2dd4bf;
}
#task-box Input {
    padding: 0 1;
    background: #111a26;
}
#task-box Input:focus {
    background: #10343a;
}
#task-box SelectCurrent {
    border: none;
    height: 1;
    padding: 0 1;
    background: #111a26;
}
#task-box Select:focus > SelectCurrent {
    border: none;
    background: #10343a;
}
#task-box Checkbox {
    padding: 0;
    background: transparent;
}
#task-box Button {
    min-width: 4;
    padding: 0 1;
}
#task-box #f-project { width: 20; }
#task-box #f-phase { width: 12; }
#task-box #f-priority { width: 10; }
#task-box .date-input {
    width: 13;
    padding: 0 0 0 1;
}
#task-box .cal-btn {
    width: 5;
    min-width: 5;
    height: 1;
    margin: 0;
    padding: 0;
}
#task-box .task-arrow {
    width: 2;
    content-align: center middle;
    color: #5b6675;
}
#task-split {
    height: 1fr;
    margin-top: 1;
}
#task-edit, #task-prev {
    width: 1fr;
    height: 1fr;
}
#task-prev {
    padding-left: 1;
}
#task-box .task-sec {
    color: #8b98a5;
}
#task-box #f-notes {
    height: 1fr;
}
#task-preview-scroll {
    height: 1fr;
    border: tall #1b2431;
    padding: 0 1;
    background: #0b111a;
    scrollbar-size: 1 1;
}
#task-foot {
    height: 5;
}
#task-foot .task-foot-col {
    width: 1fr;
    height: 5;
    margin-right: 1;
}
#task-foot TextArea {
    height: 1fr;
}
#task-actions {
    width: 16;
    height: 5;
    padding-top: 1;
}
#task-actions Button {
    width: 100%;
}

/* calendar picker */
#cal-box {
    width: 100;
    max-width: 95%;
}
#cal-grid {
    padding: 0 1;
    color: #c9d3df;
    height: auto;
}

TaskModal, ProjectModal, ConfirmModal, ProjectPicker, ImageViewer, TaskDetails, CalendarModal {
    align: center middle;
    background: #0007;
}

/* project manager list */
#proj-list {
    height: auto;
    max-height: 16;
    margin-top: 1;
    border: round #1b2431;
    background: #0b111a;
}
#proj-list:focus {
    border: round #2dd4bf;
}

/* image viewer — wider than the form modals so previews are large.
   width:100% + height:auto MUST come from the stylesheet; setting height:auto
   via widget.styles in Python collapses the image to 0 rows. */
#viewer-box, #details-box {
    width: 100;
    max-width: 95%;
}
#viewer-box Image, #details-box Image {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
