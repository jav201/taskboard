/* taskboard widget slice — monochrome ground, ONE accent, semantic hues reserved.
   Border discipline (HIERARCHY.md): NOTHING is bordered by default, so a border
   can mean "this has focus". That is the whole point of not spending it earlier. */

Screen { background: #0a0d12; color: #e8edf2; }

#ap { width: 1fr; height: 1fr; padding: 1 2; }
#top { width: 1fr; height: auto; }

/* ---- hero: the drawn metric. area = importance ---- */
#hero {
    width: 1fr;
    height: auto;
    min-height: 11;
    padding: 1 0;
    background: #0a0d12;
    /* the imperative severity animation lands on this same property */
    transition: background 220ms in_out_cubic;
}
#hero:hover  { background: #0e131a; }
#hero:focus  { border: round #2dd4bf; text-style: bold; }

/* ---- meter ---- */
#meter { width: 1fr; height: 2; margin-top: 1; }

/* ---- signal tiles: real widgets, so they get real states ---- */
#tiles { width: 1fr; height: auto; margin-top: 1; }
.tile {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: #0a0d12;
    transition: background 160ms out_cubic;
}
.tile:hover { background: #131a23; }
.tile:focus {
    background: #131a23;
    border-left: outer #2dd4bf;   /* structure … */
    text-style: bold;             /* … AND weight: never colour alone */
    padding: 0 1 0 0;
}

#queue { width: 1fr; height: auto; margin-top: 1; display: none; }

/* the view switcher — drawn by the language's kit (COMPONENTS.md tabs) */
#tabs { width: 1fr; height: 1; margin-top: 1; display: none; }
Screen.sz-widget #tabs, Screen.sz-board #tabs { display: block; }

/* ---- SIZE CLASSES: the widget adapts to its own width ---------------
   glance  (<46 cols) — hero only. the ambient state.
   widget  (46-79)    — hero + meter + signals.
   board   (>=80)     — everything, plus the queue.                    */
Screen.sz-glance #meter,
Screen.sz-glance #tiles,
Screen.sz-glance #queue   { display: none; }
Screen.sz-glance #ap      { padding: 0 1; }

Screen.sz-widget #queue   { display: block; height: auto; }

Screen.sz-board  #queue   { display: block; }

/* ---- config screen ---- */
#cfg-title { width: 1fr; height: auto; padding: 1 2 0 2; }
#cfg-scroll { width: 1fr; height: 1fr; padding: 0 2; }

/* ---- component gallery ---- */
GalleryScreen { align: center middle; background: #000a; }
#gallery-box {
    width: 58; max-width: 95%; height: auto; padding: 1 2;
    background: #0d1219; border: round #2dd4bf;
}

/* ---- help modal ---- */
HelpScreen { align: center middle; background: #000a; }
/* two columns of the FULL keymap (hidden keys included) need the width */
#help-box {
    width: 62; max-width: 90%; height: auto; padding: 1 2;
    background: #0d1219; border: round #2dd4bf;
}

Footer { background: #070a0e; color: #6b7785; }
FooterKey .footer-key--key { color: #2dd4bf; }

/* ---- the board size class: real cards, real states ---- */
#kb { width: 1fr; height: 1fr; margin-top: 1; display: none; }
Screen.sz-board #kb { display: block; }
Screen.sz-board #queue { display: none; }

.kb-row { width: 1fr; height: 1fr; }
.kb-flat { width: 1fr; height: 1fr; scrollbar-size: 1 1; }
.kb-col { height: 1fr; padding: 0 1 0 0; scrollbar-size: 1 1; }
.col-head { width: 1fr; height: 1; margin-bottom: 1; }
.kb-empty { width: 1fr; height: auto; }

.kb-card {
    width: 1fr;
    height: auto;      /* the language decides the anatomy: 1 or 2 rows */
    max-height: 3;
    padding: 0 1;
    background: #0a0d12;
    transition: background 140ms out_cubic;
}
.kb-card:hover { background: #131a23; }
.kb-card:focus {
    background: #16202b;
    border-left: outer #2dd4bf;   /* structure … */
    text-style: bold;             /* … and weight. never colour alone */
    padding: 0 1 0 0;
}

/* At board width the BOARD is the subject, so the hero yields area to it.
   Area = importance (HIERARCHY.md): the hero earns the whole screen when it is
   the only thing there, and shrinks when it is not. */
Screen.sz-board #hero  { min-height: 9; height: 9; padding: 0; }
Screen.sz-board #tiles { layout: horizontal; height: 1; }
Screen.sz-board .tile  { width: 1fr; }

/* the alternate views share the board's slot */
#view { width: 1fr; height: 1fr; margin-top: 1; display: none; }

/* the hero yields when the class cannot afford it (row budget) */
Screen.sz-glance #hero { max-height: 13; }
Screen.sz-widget #hero { max-height: 15; }
#tiles { min-height: 1; }
