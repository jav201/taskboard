.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
# local dev data copy (real data lives in ~/.taskboard/board.json)
board.json
.pytest_cache/
debug-*.log

# Local-only working areas, deliberately not committed:
#   _tui_prism_proposal/ is the design lab a concurrent agent owns. Ignoring it
#   keeps the tree clean without deciding anything permanent — committing the
#   lab instead is a one-line change here, and is the alternative if the design
#   history is ever meant to be published alongside the code.
_tui_prism_proposal/
.s19tool/
.claude/

# prototypes/out/ is a scratch yard: ~890 throwaway probes, logs and renders
# accumulate there. It was NOT ignored, so a single `git add -A` would have
# committed all of them -- and this is the directory a capture writes into, so
# the one accident and the one leak share a path. Everything is ignored and the
# few files that are genuinely inputs or reviewed artifacts are named back in.
prototypes/out/*
!prototypes/out/_fixture_late.json
!prototypes/out/kanban-baseline.svg
!prototypes/out/kanban-flow.svg
!prototypes/out/kanban-matrix.svg
!prototypes/out/kanban-triage.svg
